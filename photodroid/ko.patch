+/// Additional PhotoDroid controls, separate from the shared editor's multilingual UI. This Korean
+/// Android edition supplies Korean copy for these controls and English as the fallback; the shared
+/// editor keeps its existing complete language catalogs. Keep this set explicit so its supported
+/// translation coverage can be checked without making unreviewed changes to the other languages.
+#[derive(Clone, Copy, Debug)]
+enum AndroidLabel {
+    TextInput,
+    RightClick,
+    PrecisePointer,
+    Debug,
+    SavingLogs,
+    LogsOff,
+    CpuCores,
+    ActiveCores,
+    DecreaseCores,
+    IncreaseCores,
+    On,
+    Off,
+}
+
+impl AndroidLabel {
+    fn source(self) -> &'static str {
+        match self {
+            Self::TextInput => "Text input",
+            Self::RightClick => "Right click",
+            Self::PrecisePointer => "Precise pointer",
+            Self::Debug => "Debug",
+            Self::SavingLogs => "Saving .txt logs in Downloads/PhotoDroid",
+            Self::LogsOff => "Off — .txt log files removed",
+            Self::CpuCores => "CPU Cores",
+            Self::ActiveCores => "{active_cores} / {max_cores} active cores",
+            Self::DecreaseCores => "Decrease CPU cores",
+            Self::IncreaseCores => "Increase CPU cores",
+            Self::On => "ON",
+            Self::Off => "OFF",
+        }
+    }
+
+    fn text(self) -> &'static str {
+        i18n::tr(i18n::current(), self.source())
+    }
+}
